# Model Configuration
BASE_MODEL_PATH=models/llama-2-7b
MODEL_CACHE_DIR=~/.cache/huggingface
HF_TOKEN=your_huggingface_token_here

# Data Configuration
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
OUTPUT_DIR=outputs

# Training Configuration
DEVICE=cuda
MIXED_PRECISION=bf16
NUM_GPUS=1
PER_DEVICE_TRAIN_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=4
NUM_TRAIN_EPOCHS=3
LEARNING_RATE=2e-4

# LoRA Configuration
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,v_proj

# DeepSpeed Configuration
DEEPSPEED_CONFIG=configs/deepspeed_config.json
ZERO_STAGE=2

# Logging Configuration
WANDB_PROJECT=llm-finetuning-peft
WANDB_ENTITY=your_wandb_entity
WANDB_API_KEY=your_wandb_api_key
LOG_LEVEL=INFO
LOG_DIR=logs

# Evaluation Configuration
EVAL_STRATEGY=steps
EVAL_STEPS=500
SAVE_STRATEGY=steps
SAVE_STEPS=500
SAVE_TOTAL_LIMIT=3

# Deployment Configuration
API_HOST=0.0.0.0
API_PORT=8000
MAX_LENGTH=2048
TEMPERATURE=0.7
TOP_P=0.9

# Resource Limits
MAX_WORKERS=4
TIMEOUT_SECONDS=300